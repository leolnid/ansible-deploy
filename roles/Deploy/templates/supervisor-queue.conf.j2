[program:{{ domain | replace('.', '-') }}-queue]
command=php {{ remote_root_path }}/artisan queue:work --queue=webhooks,default --tries=3 --backoff=10 --timeout=180
directory={{ remote_root_path }}
user=www-data
process_name=%(program_name)s_%(process_num)02d

autostart=true
autorestart=true
numprocs=2
redirect_stderr=true
stdout_logfile={{ remote_storage_path }}/logs/queue.log
stderr_logfile={{ remote_storage_path }}/logs/queue.log
